SECRET_KEY=replace-with-a-long-random-secret
DJANGO_DEBUG=True
ALLOWED_HOSTS=localhost,127.0.0.1
CORS_ALLOW_ALL_ORIGINS=True
CORS_ALLOWED_ORIGINS=
CSRF_TRUSTED_ORIGINS=
SECURE_SSL_REDIRECT=False
SECURE_HSTS_SECONDS=0
SECURE_REFERRER_POLICY=strict-origin-when-cross-origin

# Leave POSTGRES_DB empty to use local SQLite during development.
POSTGRES_DB=
POSTGRES_USER=
POSTGRES_PASSWORD=
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_SSLMODE=prefer
POSTGRES_CHANNEL_BINDING=prefer

# Production realtime layer. Leave empty to use in-memory Channels locally.
# Example: redis://localhost:6379/0
REDIS_URL=

# Google Maps web rendering and server-side routing.
GOOGLE_MAPS_WEB_API_KEY=
GOOGLE_MAPS_SERVER_API_KEY=
GOOGLE_MAP_ID=

# Password-reset email delivery. Local development may use the console backend.
EMAIL_BACKEND=django.core.mail.backends.console.EmailBackend
EMAIL_HOST=
EMAIL_PORT=587
EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD=
EMAIL_USE_TLS=True
EMAIL_USE_SSL=False
DEFAULT_FROM_EMAIL=NaviGo-Locate <no-reply@example.com>
PASSWORD_RESET_OTP_MINUTES=10
