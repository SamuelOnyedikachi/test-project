SECRET_KEY=replace-me
DJANGO_DEBUG=False
ALLOWED_HOSTS=localhost,127.0.0.1
CORS_ALLOW_ALL_ORIGINS=True
CORS_ALLOWED_ORIGINS=
CSRF_TRUSTED_ORIGINS=
SECURE_SSL_REDIRECT=False
SECURE_HSTS_SECONDS=0
SECURE_REFERRER_POLICY=strict-origin-when-cross-origin

POSTGRES_DB=navigo
POSTGRES_USER=navigo
POSTGRES_PASSWORD=navigo
POSTGRES_HOST=db
POSTGRES_PORT=5432
POSTGRES_SSLMODE=prefer
POSTGRES_CHANNEL_BINDING=prefer

REDIS_URL=redis://redis:6379/0

# Optional local PostGIS container (`docker compose --profile local-db up db`).
LOCAL_POSTGRES_DB=navigo
LOCAL_POSTGRES_USER=navigo
LOCAL_POSTGRES_PASSWORD=navigo
