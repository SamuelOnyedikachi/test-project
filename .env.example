SECRET_KEY=replace-me
DJANGO_DEBUG=False
ALLOWED_HOSTS=localhost,127.0.0.1
CORS_ALLOW_ALL_ORIGINS=True
CORS_ALLOWED_ORIGINS=
CSRF_TRUSTED_ORIGINS=
SECURE_SSL_REDIRECT=False
SECURE_HSTS_SECONDS=0
SECURE_REFERRER_POLICY=strict-origin-when-cross-origin

POSTGRES_DB=navigo
POSTGRES_USER=navigo
POSTGRES_PASSWORD=navigo
POSTGRES_HOST=db
POSTGRES_PORT=5432
POSTGRES_SSLMODE=prefer
POSTGRES_CHANNEL_BINDING=prefer

REDIS_URL=redis://redis:6379/0

# Optional local PostGIS container (`docker compose --profile local-db up db`).
LOCAL_POSTGRES_DB=navigo
LOCAL_POSTGRES_USER=navigo
LOCAL_POSTGRES_PASSWORD=navigo

GOOGLE_MAPS_WEB_API_KEY=
GOOGLE_MAPS_SERVER_API_KEY=
GOOGLE_MAP_ID=

# Password-reset email delivery. Use credentials from your SMTP provider.
EMAIL_BACKEND=django.core.mail.backends.smtp.EmailBackend
EMAIL_HOST=smtp.example.com
EMAIL_PORT=587
EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD=
EMAIL_USE_TLS=True
EMAIL_USE_SSL=False
DEFAULT_FROM_EMAIL=NaviGo-Locate <no-reply@example.com>
PASSWORD_RESET_OTP_MINUTES=10
